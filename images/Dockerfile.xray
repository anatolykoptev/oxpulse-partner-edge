# syntax=docker/dockerfile:1.7
# Partner-agnostic xray-core client image. config.json is bind-mounted.
#
# xray-core pin: teddysun/xray:<tag> maps 1:1 to XTLS/Xray-core releases.
# Current pin: 26.5.9 — bumped from 26.4.25 on 2026-05-20 (2026-05-20 fleet
# outage RCA). 26.4.25 was unaffected by the 26.5.3 CurvePreferences crash
# but had the 26.4+ default-deny private-IP matcher in freedom outbound that
# silently broke xray-reality → 127.0.0.1:8907 forwarding. Fix lives in the
# server renderer (oxpulse-chat xray_config.rs `ipsBlocked: []`).
# 26.5.9 empirically tested: starts cleanly with `fingerprint: randomized`
# (the 26.5.3 utls/CurvePreferences regression IS fixed by 26.5.9).
# To bump further: edit the FROM tag below AND open a bundle release (bump
# VERSION in release-please or tag manually) so partner-edge-xray image
# rebuilds.
FROM teddysun/xray:latest

ARG VERSION=dev
LABEL org.opencontainers.image.source="https://github.com/anatolykoptev/oxpulse-partner-edge"
LABEL org.opencontainers.image.description="OxPulse partner-edge xray-client — VLESS+Reality+XHTTP tunnel"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL oxpulse.component="partner-edge-xray"
LABEL oxpulse.version="${VERSION}"

# Upstream image lacks `ss`; add iproute2-style check tool for healthcheck.
USER root
RUN (apk add --no-cache iproute2 2>/dev/null \
  || (command -v apt-get >/dev/null && apt-get update -q && apt-get install -y -q iproute2 && rm -rf /var/lib/apt/lists/*) \
  || true)

EXPOSE 3080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD sh -c "ss -ltn 2>/dev/null | grep -q ':3080 ' || netstat -ltn 2>/dev/null | grep -q ':3080 ' || exit 1"

# Upstream ENTRYPOINT launches xray with /etc/xray/config.json.
