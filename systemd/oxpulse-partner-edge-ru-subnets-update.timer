[Unit]
Description=Daily RU-subnet list refresh for OxPulse partner-edge split-routing
After=network-online.target

# Daily at 03:33 UTC.  Persistent=true means a missed run (box was offline)
# fires on the next boot — ensures the list is always refreshed even on edges
# that are rebooted infrequently.
[Timer]
OnCalendar=*-*-* 03:33:00
Persistent=true

[Install]
WantedBy=timers.target
